# Optional. Mail already works out of the box via the team's Mailtrap sandbox
# (defaults in docker-compose.yml / application.properties).
# Copy to .env only to use your own provider. .env is git-ignored.
APP_MAIL_ENABLED=true
APP_MAIL_FROM=noreply@biletflow.kz
SPRING_MAIL_HOST=sandbox.smtp.mailtrap.io
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<your mailtrap username>
SPRING_MAIL_PASSWORD=<your mailtrap password>
